PORT=4000
FRONTEND_URL=http://localhost:5500

# PostgreSQL
# Local Postgres example: postgres://postgres:postgres@localhost:5432/agro_marketplace
# Managed providers (Render, Railway, RDS, Supabase, etc.) give you a full
# connection string - paste it here as-is.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agro_marketplace
# Set to true for managed providers that require SSL with a self-signed cert
# (most of them). Leave false for a local Postgres install.
PGSSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BUYER_SERVICE_FEE_PERCENT=0.02
SELLER_COMMISSION_PERCENT=0.02
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-12-character-password
CRYPTO_DEFAULT_NETWORK=TRC20
# Add receiving addresses only after you have chosen a compliant crypto processor/wallet setup.
# CRYPTO_USDT_TRC20_ADDRESS=
# CRYPTO_USDC_ETH_ADDRESS=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_SWIFT=
